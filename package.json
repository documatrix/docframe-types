{
  "name": "docframe-types",
  "version": "1.0.0",
  "description": "docframe-types contains type definitions for creating documents (e. g. using Deuterium)",
  "keywords": [
    "formatting",
    "rendering",
    "typescript",
    "document"
  ],
  "homepage": "https://documatrix.com",
  "bugs": {
    "url": "https://github.com/documatrix/docframe-types/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/documatrix/docframe-types.git"
  },
  "engineStrict": true,
  "engines": {
    "node": ">= 18"
  },
  "main": "build/index.js",
  "scripts": {
    "build": "buf generate && node tools/ts-index/gen-index.mjs build",
    "lint": "buf lint",
    "breaking": "buf breaking --against '.git#ref=refs/remotes/origin/main'",
    "commit": "npm run build && npm version patch && npm publish && git push"
  },
  "author": "DocuMatrix <office@documatrix.com>",
  "license": "MIT",
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0"
  },
  "types": "build/index.d.ts",
  "files": [
    "build",
    "!build/csharp",
    "src",
    "README.md",
    "LICENSE"
  ]
}
